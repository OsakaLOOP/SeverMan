HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
TRUSTED_PROXY_CIDRS=
DATABASE_URL=postgresql://sm_app:replace-with-app-password@127.0.0.1:5432/sm
READ_DATABASE_URL=postgresql://sm_read:replace-with-reader-password@127.0.0.1:5432/sm
MIGRATION_DATABASE_URL=postgresql://postgres:replace-with-bootstrap-password@127.0.0.1:5432/sm
APP_DATABASE_PASSWORD=replace-with-at-least-24-random-characters
READ_DATABASE_PASSWORD=replace-with-another-24-random-characters
AUTH_ORIGIN=http://127.0.0.1:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_DATABASE_URL=postgresql://sm_app:replace-with-app-password@127.0.0.1:5432/sm
QUEUE_DATABASE_URL=postgresql://sm_app:replace-with-app-password@127.0.0.1:5432/sm
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_IDS=
WEBHOOK_TARGETS_JSON={}
# Docker Compose 上机配置；数据库 URL 的主机名统一改为 postgres。
AUTH_DOMAIN=
POSTGRES_PASSWORD=
# 子站样板：npm run example:site
SITE_ORIGIN=http://127.0.0.1:4100
SITE_ISSUER=http://127.0.0.1:3000/api/auth
SITE_CLIENT_ID=
