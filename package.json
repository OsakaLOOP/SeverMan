{
  "name": "sm-service-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:local": "tsx scripts/dev-local.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts web",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:migrate": "tsx scripts/platform-migrate.ts",
    "worker": "tsx src/worker.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "resource:register": "tsx scripts/register-resource.ts",
    "auth:generate": "tsx scripts/generate-auth.ts",
    "example:site": "tsx examples/site/server.ts",
    "test:browser": "tsx scripts/browser-check.ts",
    "db:provision": "tsx scripts/provision-cli.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@aws-sdk/s3-request-presigner": "3.1127.0",
    "@better-auth/oauth-provider": "1.7.3",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "better-auth": "1.7.3",
    "fastify": "5.12.3",
    "jose": "6.2.12",
    "kysely": "0.28.17",
    "lucide-react": "1.42.0",
    "nodemailer": "10.0.1",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
