{
  "name": "sm-service-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:local": "tsx scripts/dev-local.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:provision": "tsx scripts/provision-cli.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "fastify": "5.12.3",
    "kysely": "0.28.17",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
