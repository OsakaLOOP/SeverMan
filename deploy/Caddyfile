{$AUTH_DOMAIN} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    X-Frame-Options DENY
    Strict-Transport-Security "max-age=31536000"
  }
  reverse_proxy core:3000 {
    transport http {
      dial_timeout 3s
      response_header_timeout 10s
    }
  }
}
